.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
# OS / editor
*.swp
.idea/
.vscode/
# Build / env (language-agnostic defaults; trim once a stack is chosen)
node_modules/
dist/
build/
target/
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
*.log
